url_semilla = "https://es.wikipedia.org/wiki/Dioses_olímpicos"

print(f"Buscando páginas con contenido similar a: {url_semilla}\n")

try:
    # 3. Realizar búsqueda de páginas similares
    # El método find_similar toma la URL y busca en su base de datos vectorial web
    response = exa.find_similar(
        url=url_semilla,
        num_results=5,                 # Número de páginas a retornar
        contents={
            "summary": {               # Pide a Exa un resumen automático de cada página
                "query": "Resumen del tema principal del artículo"
            },
            "highlights": True         # Extrae los fragmentos más relevantes
        }
    )

    # 4. Procesar y mostrar los resultados
    for i, result in enumerate(response.results, 1):
        print(f"--- Resultado #{i} ---")
        print(f"Título: {result.title}")
        print(f"URL: {result.url}")
        print(f"Fecha de publicación: {result.published_date}")
        
        if hasattr(result, 'summary') and result.summary:
            print(f"Resumen: {result.summary}")
            
        if hasattr(result, 'highlights') and result.highlights:
            print(f"Destacado: {result.highlights[0]}")
            
        print("\n")

except Exception as e:
    print(f"Error al realizar la búsqueda: {e}")